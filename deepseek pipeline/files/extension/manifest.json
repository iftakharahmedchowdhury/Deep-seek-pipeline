{
  "manifest_version": 3,
  "name": "DeepSeek Local Bridge",
  "version": "0.5.0",
  "description": "Runs tool calls from DeepSeek chat on your local bridge server and sends results back.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
